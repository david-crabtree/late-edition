{
  "name": "late-edition",
  "version": "0.0.1",
  "private": true,
  "description": "A noir newsroom that turns your own AI agents into a daily paper.",
  "license": "Apache-2.0 WITH Commons-Clause",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/electron/main.js",
  "bin": {
    "late-edition": "./dist/cli/index.js"
  },
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node -e \"require('fs').copyFileSync('src/electron/preload.cjs','dist/electron/preload.cjs')\"",
    "app": "npm run build && electron .",
    "electron": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run check:ui && npm run check:notices && npm run test",
    "dist": "npm run icon && npm run build && electron-builder --publish never",
    "dist:win": "npm run icon && npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run icon && npm run build && electron-builder --linux --publish never",
    "dist:mac": "npm run icon && npm run build && electron-builder --mac --publish never",
    "icon": "node scripts/make-icon.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "check:notices": "node scripts/third-party-notices.mjs --check"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "diff": "^5.2.0",
    "rss-parser": "^3.13.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/diff": "^5.2.3",
    "@types/node": "^20.16.5",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "author": "David Crabtree",
  "build": {
    "appId": "com.lateedition.app",
    "productName": "Late Edition",
    "copyright": "Copyright 2026 David Crabtree",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "docs/prototype/newsroom-screen-test.html",
      "package.json",
      "!**/*.map",
      "!**/*.test.*",
      "scripts/after-sign.mjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.news",
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    },
    "extraResources": ["LICENSE", "NOTICE", "THIRD_PARTY_NOTICES.md"],
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "afterSign": "scripts/after-sign.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/late-edition/late-edition.git"
  },
  "bugs": {
    "url": "https://github.com/late-edition/late-edition/issues"
  },
  "homepage": "https://github.com/late-edition/late-edition",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/david-crabtree"
    }
  ]
}
